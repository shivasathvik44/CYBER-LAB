# ==============================================================================
# Cybersecurity Homelab - Environment Variables Template
# Copy this file to .env and adjust variables for your local lab environment.
# DO NOT COMMIT SENSITIVE VALUES OR ACTUAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Lab Network Configuration
HOMELAB_SUBNET=172.20.0.0/16
HOMELAB_GATEWAY=172.20.0.1

# OWASP Juice Shop Configuration
JUICE_SHOP_PORT=3000
JUICE_SHOP_IP=172.20.0.20
NODE_ENV=development

# Wazuh Single-Node Deployment Settings (Placeholder Credentials for Lab Only)
# Note: For production or external-facing labs, use strong generated passwords.
INDEXER_PASSWORD=HomelabAdminPass123!
API_PASSWORD=HomelabApiPass123!
WAZUH_DASHBOARD_PORT=443
WAZUH_INDEXER_PORT=9200
WAZUH_MANAGER_PORT=1514
WAZUH_API_PORT=55000

# Endpoint Telemetry Settings
ENDPOINT_HOSTNAME=fedora-endpoint
AUDITD_LOG_PATH=/var/log/audit/audit.log
AUTH_LOG_PATH=/var/log/secure

# Suricata IDS Network Settings
SURICATA_INTERFACE=eth0
SURICATA_LOG_DIR=./deployment/suricata/logs

# Python Automation Settings
LOG_ANALYZER_DEFAULT_THRESHOLD=5
INTEGRITY_BASELINE_PATH=./evidence/sample-logs/baseline.json
