## Linux Audit Rules for Homelab Endpoint Telemetry
## Reference: MITRE ATT&CK TA0002 (Execution), TA0004 (Privilege Escalation), TA0005 (Defense Evasion)

# Delete all existing rules
-D

# Set buffer size
-b 8192

# Failure mode (1 = printk, 2 = panic)
-f 1

# 1. Monitor user / group file modifications (TA0004 / TA0006)
-w /etc/group -p wa -k identity_changes
-w /etc/passwd -p wa -k identity_changes
-w /etc/gshadow -p wa -k identity_changes
-w /etc/shadow -p wa -k identity_changes
-w /etc/security/opasswd -p wa -k identity_changes

# 2. Monitor privilege escalation configuration (sudoers)
-w /etc/sudoers -p wa -k sudoers_changes
-w /etc/sudoers.d/ -p wa -k sudoers_changes

# 3. Process execution tracking (64-bit and 32-bit syscalls) (TA0002)
-a always,exit -F arch=b64 -S execve -k process_exec
-a always,exit -F arch=b64 -S execveat -k process_exec
-a always,exit -F arch=b32 -S execve -k process_exec
-a always,exit -F arch=b32 -S execveat -k process_exec

# 4. Monitor suspicious reconnaissance / network tooling usage
-w /usr/bin/ncat -p x -k net_recon
-w /usr/bin/nc -p x -k net_recon
-w /usr/bin/socat -p x -k net_recon
-w /usr/bin/tcpdump -p x -k net_recon
-w /usr/bin/nmap -p x -k net_recon

# 5. Monitor scheduled tasks / persistence (TA0003)
-w /etc/cron.allow -p wa -k cron_tamper
-w /etc/cron.deny -p wa -k cron_tamper
-w /etc/cron.d/ -p wa -k cron_tamper
-w /etc/cron.daily/ -p wa -k cron_tamper
-w /etc/crontab -p wa -k cron_tamper
-w /var/spool/cron/ -p wa -k cron_tamper
