# ==============================================================================
# Local Suricata Rules for Cybersecurity Homelab
# SID Range: 1000000 - 1000999 (Local User Defined Rules)
# ==============================================================================

# 1. Nmap OS / Version Scan Fingerprint Detection
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"HOMELAB SCAN Potential Nmap Scripting Engine or SYN Sweep"; flags:S,12; threshold:type both, track by_src, count 20, seconds 5; classtype:attempted-recon; sid:1000001; rev:1;)

# 2. SQL Injection Pattern in HTTP GET Parameter (OWASP Juice Shop target)
alert http $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"HOMELAB WEB SQL Injection Attempt - UNION SELECT"; flow:to_server,established; content:"UNION"; nocase; http_uri; content:"SELECT"; nocase; http_uri; classtype:web-application-attack; sid:1000002; rev:1;)

# 3. Path Traversal Pattern in HTTP Request
alert http $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"HOMELAB WEB Directory Traversal Attempt (../)"; flow:to_server,established; content:"..%2f"; nocase; http_uri; classtype:web-application-attack; sid:1000003; rev:1;)

# 4. SSH High Frequency Connection Attempts
alert tcp $EXTERNAL_NET any -> $SSH_SERVERS 22 (msg:"HOMELAB AUTH Rapid SSH Connection Attempts (Potential Brute-Force)"; flow:to_server; flags:S; threshold:type both, track by_src, count 10, seconds 30; classtype:suspicious-login; sid:1000004; rev:1;)
