<!-- Local custom rules for Cybersecurity Homelab -->
<group name="local,syslog,sshd,">

  <!-- Rule 100001: Detect SSH Brute-Force Activity (High Frequency) -->
  <rule id="100001" level="10" frequency="6" timeframe="120">
    <if_matched_sid>5710</if_matched_sid>
    <same_source_ip />
    <description>Homelab: High frequency SSH authentication failures from single IP (Possible Brute-Force)</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

  <!-- Rule 100002: Detect Root Login Attempts over SSH -->
  <rule id="100002" level="8">
    <if_sid>5710</if_sid>
    <match>Failed password for root</match>
    <description>Homelab: Direct SSH failed login attempt for root user</description>
    <mitre>
      <id>T1078.003</id>
    </mitre>
  </rule>

  <!-- Rule 100003: Monitored Directory File Tampering Alert -->
  <rule id="100003" level="7">
    <if_sid>550</if_sid>
    <match>/tmp/homelab-fim-test</match>
    <description>Homelab FIM: Integrity modification detected in monitored lab directory</description>
    <mitre>
      <id>T1565.001</id>
    </mitre>
  </rule>

</group>
